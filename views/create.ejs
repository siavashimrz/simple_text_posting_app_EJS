<%- include("partials/header.ejs") %>
    <% if (locals.blog) { %>
        <div class="create-container">
            <form action="/blog/<%= blog.bID %>/edit" method="post">
                <!-- <label for="title">Title</label> -->
                <input type="text" name="title" required value=<%=blog.bTitle%>>
                <!-- <label for="text">Text</label> -->
                <textarea name="text"><%=blog.bText%></textarea>
                <input type="submit" value="Save Edit">
            </form>
        </div>
        <% } else { %>
            <div class="create-container">
                <form action="/" method="post">
                    <!-- <label for="title">Title</label> -->
                    <input type="text" name="title" id="" required placeholder="Input title ...">
                    <!-- <label for="text">Text</label> -->
                    <textarea name="text" id="" placeholder="Input text ..."></textarea>
                    <input type="submit" value="Create">
                </form>
            </div>
            <% } %>


                <%- include("partials/footer.ejs") %>